folder_id   = "b1g..."   # yc resource-manager folder list
registry_id = "crp..."   # yc container registry list — the default registry

# One entry per deploy channel. The key names the channel and must be unique;
# it is what lets two channels watch the same image.
#
#   image        = image repository name, no registry_id prefix
#   container_id = yc serverless container list
#   registry_id  = optional, defaults to the registry_id above
#   tag          = optional, only this tag fires the trigger and routes here
image_container_map = {
  myapp = {
    image        = "myapp"
    container_id = "bba..."
  }

  # Same image, two tags, two containers: CI pushes `test` on merge, and the
  # production workflow moves `prod` onto a build that has proven itself.
  # A channel may also name its own registry, which is how one stack serves
  # images that do not live in the default one.
  # otherapp-test = {
  #   image        = "otherapp"
  #   registry_id  = "crp..."
  #   tag          = "test"
  #   container_id = "bbb..."
  # }
  # otherapp-prod = {
  #   image        = "otherapp"
  #   registry_id  = "crp..."
  #   tag          = "prod"
  #   container_id = "bbc..."
  # }
}

# Optional overrides
function_name    = "registry-deploy"
function_memory  = 128
function_timeout = 30
